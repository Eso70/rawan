// Rawan Database Schema
// PostgreSQL + Prisma 7

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AUTHOR
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  name     String
  password String?
  role     UserRole @default(AUTHOR)

  author        Author?
  aiGenerations AiGeneration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Author {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String
  bio         String?
  avatarUrl   String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Project {
  id               String            @id @default(cuid())
  authorId         String
  title            String
  description      String?
  author           Author            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  books            Book[]
  characters       Character[]
  places           Place[]
  factions         Faction[]
  artifacts        Artifact[]
  relationships    Relationship[]
  timelines        Timeline[]
  plots            Plot[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  notes            Note[]
  tags             Tag[]
  tagAssignments   TagAssignment[]
  mediaAttachments MediaAttachment[]
  media            Media[]
  aiGenerations    AiGeneration[]

  @@index([authorId, createdAt(sort: Desc), id])
}

model Book {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  position    Int       @default(0)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters    Chapter[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  plotPointScenes PlotPointScene[]
  tagAssignments  TagAssignment[]

  @@unique([projectId, id])
  @@index([projectId, position])
}

model Chapter {
  id          String   @id @default(cuid())
  bookId      String
  title       String
  description String?
  position    Int      @default(0)
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plotPointScenes PlotPointScene[]
  tagAssignments  TagAssignment[]

  @@unique([bookId, id])
  @@index([bookId, position])
}

model Scene {
  id          String   @id @default(cuid())
  chapterId   String
  title       String
  description String?
  content     String   @default("")
  position    Int      @default(0)
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plotPoints     PlotPointScene[]
  tagAssignments TagAssignment[]

  @@unique([chapterId, id])
  @@index([chapterId, position, createdAt, id])
}

model Character {
  id                  String            @id @default(cuid())
  projectId           String
  name                String
  summary             String?
  description         String?
  role                String?
  status              String?
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sourceRelationships Relationship[]    @relation("SourceCharacter")
  targetRelationships Relationship[]    @relation("TargetCharacter")
  eventEntities       EventEntity[]
  plotPointEntities   PlotPointEntity[]
  tagAssignments      TagAssignment[]
  mediaAttachments    MediaAttachment[]

  @@unique([projectId, id])
  @@index([projectId, name, id])
}

model Place {
  id                  String            @id @default(cuid())
  projectId           String
  name                String
  summary             String?
  description         String?
  type                String?
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sourceRelationships Relationship[]    @relation("SourcePlace")
  targetRelationships Relationship[]    @relation("TargetPlace")
  eventEntities       EventEntity[]
  plotPointEntities   PlotPointEntity[]
  tagAssignments      TagAssignment[]
  mediaAttachments    MediaAttachment[]

  @@unique([projectId, id])
  @@index([projectId, name, id])
}

model Faction {
  id                  String            @id @default(cuid())
  projectId           String
  name                String
  summary             String?
  description         String?
  type                String?
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sourceRelationships Relationship[]    @relation("SourceFaction")
  targetRelationships Relationship[]    @relation("TargetFaction")
  eventEntities       EventEntity[]
  plotPointEntities   PlotPointEntity[]
  tagAssignments      TagAssignment[]
  mediaAttachments    MediaAttachment[]

  @@unique([projectId, id])
  @@index([projectId, name, id])
}

model Artifact {
  id                  String            @id @default(cuid())
  projectId           String
  name                String
  summary             String?
  description         String?
  type                String?
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sourceRelationships Relationship[]    @relation("SourceArtifact")
  targetRelationships Relationship[]    @relation("TargetArtifact")
  eventEntities       EventEntity[]
  plotPointEntities   PlotPointEntity[]
  tagAssignments      TagAssignment[]
  mediaAttachments    MediaAttachment[]

  @@unique([projectId, id])
  @@index([projectId, name, id])
}

enum WorldEntityKind {
  CHARACTER
  PLACE
  FACTION
  ARTIFACT
}

enum RelationshipDirection {
  DIRECTIONAL
  SYMMETRIC
}

model Relationship {
  id                String                @id @default(cuid())
  projectId         String
  sourceKind        WorldEntityKind
  targetKind        WorldEntityKind
  typeKey           String
  label             String
  description       String?
  direction         RelationshipDirection @default(DIRECTIONAL)
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCharacterId String?
  sourceCharacter   Character?            @relation("SourceCharacter", fields: [projectId, sourceCharacterId], references: [projectId, id], onDelete: Cascade)
  sourcePlaceId     String?
  sourcePlace       Place?                @relation("SourcePlace", fields: [projectId, sourcePlaceId], references: [projectId, id], onDelete: Cascade)
  sourceFactionId   String?
  sourceFaction     Faction?              @relation("SourceFaction", fields: [projectId, sourceFactionId], references: [projectId, id], onDelete: Cascade)
  sourceArtifactId  String?
  sourceArtifact    Artifact?             @relation("SourceArtifact", fields: [projectId, sourceArtifactId], references: [projectId, id], onDelete: Cascade)
  targetCharacterId String?
  targetCharacter   Character?            @relation("TargetCharacter", fields: [projectId, targetCharacterId], references: [projectId, id], onDelete: Cascade)
  targetPlaceId     String?
  targetPlace       Place?                @relation("TargetPlace", fields: [projectId, targetPlaceId], references: [projectId, id], onDelete: Cascade)
  targetFactionId   String?
  targetFaction     Faction?              @relation("TargetFaction", fields: [projectId, targetFactionId], references: [projectId, id], onDelete: Cascade)
  targetArtifactId  String?
  targetArtifact    Artifact?             @relation("TargetArtifact", fields: [projectId, targetArtifactId], references: [projectId, id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([projectId, createdAt(sort: Desc), id])
  @@index([projectId, typeKey, createdAt])
  @@index([projectId, sourceCharacterId])
  @@index([projectId, sourcePlaceId])
  @@index([projectId, sourceFactionId])
  @@index([projectId, sourceArtifactId])
  @@index([projectId, targetCharacterId])
  @@index([projectId, targetPlaceId])
  @@index([projectId, targetFactionId])
  @@index([projectId, targetArtifactId])
}

model Timeline {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eras        Era[]
  events      TimelineEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([projectId, id])
  @@index([projectId, createdAt, id])
}

model Era {
  id          String          @id @default(cuid())
  timelineId  String
  name        String
  description String?
  position    Int             @default(0)
  start       Decimal?        @db.Decimal(30, 6)
  end         Decimal?        @db.Decimal(30, 6)
  timeline    Timeline        @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  events      TimelineEvent[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([timelineId, id])
  @@index([timelineId, position, id])
}

model TimelineEvent {
  id             String           @id @default(cuid())
  projectId      String
  timelineId     String
  eraId          String?
  title          String
  summary        String?
  description    String?
  start          Decimal          @db.Decimal(30, 6)
  end            Decimal?         @db.Decimal(30, 6)
  dateLabel      String?
  position       Int              @default(0)
  timeline       Timeline         @relation(fields: [projectId, timelineId], references: [projectId, id], onDelete: Cascade)
  era            Era?             @relation(fields: [timelineId, eraId], references: [timelineId, id], onDelete: NoAction)
  entities       EventEntity[]
  plotPoints     PlotPointEvent[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tagAssignments TagAssignment[]

  @@unique([projectId, id])
  @@index([timelineId, start, position, id])
  @@index([timelineId, eraId, start, position, id])
}

model EventEntity {
  id          String          @id @default(cuid())
  projectId   String
  eventId     String
  kind        WorldEntityKind
  role        String?
  characterId String?
  placeId     String?
  factionId   String?
  artifactId  String?
  event       TimelineEvent   @relation(fields: [projectId, eventId], references: [projectId, id], onDelete: Cascade)
  character   Character?      @relation(fields: [projectId, characterId], references: [projectId, id], onDelete: Cascade)
  place       Place?          @relation(fields: [projectId, placeId], references: [projectId, id], onDelete: Cascade)
  faction     Faction?        @relation(fields: [projectId, factionId], references: [projectId, id], onDelete: Cascade)
  artifact    Artifact?       @relation(fields: [projectId, artifactId], references: [projectId, id], onDelete: Cascade)

  @@index([eventId, id])
  @@index([projectId, characterId, eventId])
  @@index([projectId, placeId, eventId])
  @@index([projectId, factionId, eventId])
  @@index([projectId, artifactId, eventId])
}

enum PlotPointStatus {
  PLANNED
  IN_PROGRESS
  RESOLVED
}

model Plot {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  description String?
  category    String?
  position    Int         @default(0)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  points      PlotPoint[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, id])
  @@index([projectId, position, id])
}

model PlotPoint {
  id             String            @id @default(cuid())
  projectId      String
  plotId         String
  title          String
  description    String?
  position       Int               @default(0)
  status         PlotPointStatus   @default(PLANNED)
  plot           Plot              @relation(fields: [projectId, plotId], references: [projectId, id], onDelete: Cascade)
  scenes         PlotPointScene[]
  events         PlotPointEvent[]
  entities       PlotPointEntity[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tagAssignments TagAssignment[]

  @@unique([projectId, id])
  @@index([plotId, position, id])
}

// The manuscript path proves the scene belongs to the association's project.
// No redundant project columns or backfills are needed in existing manuscript rows.
model PlotPointScene {
  id        String    @id @default(cuid())
  projectId String
  pointId   String
  sceneId   String
  chapterId String
  bookId    String
  point     PlotPoint @relation(fields: [projectId, pointId], references: [projectId, id], onDelete: Cascade)
  book      Book      @relation(fields: [projectId, bookId], references: [projectId, id], onDelete: Cascade)
  chapter   Chapter   @relation(fields: [bookId, chapterId], references: [bookId, id], onDelete: Cascade)
  scene     Scene     @relation(fields: [chapterId, sceneId], references: [chapterId, id], onDelete: Cascade)

  @@unique([pointId, sceneId])
  @@index([sceneId, pointId])
  @@index([projectId, bookId])
  @@index([bookId, chapterId])
}

model PlotPointEvent {
  id        String        @id @default(cuid())
  projectId String
  pointId   String
  eventId   String
  point     PlotPoint     @relation(fields: [projectId, pointId], references: [projectId, id], onDelete: Cascade)
  event     TimelineEvent @relation(fields: [projectId, eventId], references: [projectId, id], onDelete: Cascade)

  @@unique([pointId, eventId])
  @@index([eventId, pointId])
}

model PlotPointEntity {
  id          String          @id @default(cuid())
  projectId   String
  pointId     String
  kind        WorldEntityKind
  role        String?
  characterId String?
  placeId     String?
  factionId   String?
  artifactId  String?
  point       PlotPoint       @relation(fields: [projectId, pointId], references: [projectId, id], onDelete: Cascade)
  character   Character?      @relation(fields: [projectId, characterId], references: [projectId, id], onDelete: Cascade)
  place       Place?          @relation(fields: [projectId, placeId], references: [projectId, id], onDelete: Cascade)
  faction     Faction?        @relation(fields: [projectId, factionId], references: [projectId, id], onDelete: Cascade)
  artifact    Artifact?       @relation(fields: [projectId, artifactId], references: [projectId, id], onDelete: Cascade)

  @@index([pointId, id])
  @@index([projectId, characterId, pointId])
  @@index([projectId, placeId, pointId])
  @@index([projectId, factionId, pointId])
  @@index([projectId, artifactId, pointId])
}

model Note {
  id               String            @id @default(cuid())
  projectId        String
  title            String
  content          String            @default("")
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tagAssignments   TagAssignment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  mediaAttachments MediaAttachment[]

  @@unique([projectId, id])
  @@index([projectId, updatedAt(sort: Desc), id])
}

model Tag {
  id             String          @id @default(cuid())
  projectId      String
  name           String
  // Database trigger derives this key on every write, using PostgreSQL's case rules.
  normalizedName String          @default("")
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments    TagAssignment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([projectId, id])
  @@unique([projectId, normalizedName])
}

enum TagResourceKind {
  NOTE
  CHARACTER
  PLACE
  FACTION
  ARTIFACT
  SCENE
  TIMELINE_EVENT
  PLOT_POINT
}

model TagAssignment {
  id           String          @id @default(cuid())
  projectId    String
  tagId        String
  resourceKind TagResourceKind
  noteId       String?
  characterId  String?
  placeId      String?
  factionId    String?
  artifactId   String?
  sceneId      String?
  eventId      String?
  plotPointId  String?
  bookId       String?
  chapterId    String?
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag          Tag             @relation(fields: [projectId, tagId], references: [projectId, id], onDelete: Cascade)
  note         Note?           @relation(fields: [projectId, noteId], references: [projectId, id], onDelete: Cascade)
  character    Character?      @relation(fields: [projectId, characterId], references: [projectId, id], onDelete: Cascade)
  place        Place?          @relation(fields: [projectId, placeId], references: [projectId, id], onDelete: Cascade)
  faction      Faction?        @relation(fields: [projectId, factionId], references: [projectId, id], onDelete: Cascade)
  artifact     Artifact?       @relation(fields: [projectId, artifactId], references: [projectId, id], onDelete: Cascade)
  book         Book?           @relation(fields: [projectId, bookId], references: [projectId, id], onDelete: Cascade)
  chapter      Chapter?        @relation(fields: [bookId, chapterId], references: [bookId, id], onDelete: Cascade)
  scene        Scene?          @relation(fields: [chapterId, sceneId], references: [chapterId, id], onDelete: Cascade)
  event        TimelineEvent?  @relation(fields: [projectId, eventId], references: [projectId, id], onDelete: Cascade)
  plotPoint    PlotPoint?      @relation(fields: [projectId, plotPointId], references: [projectId, id], onDelete: Cascade)

  @@index([tagId, resourceKind, id])
  @@index([projectId, noteId, tagId])
  @@index([projectId, characterId, tagId])
  @@index([projectId, placeId, tagId])
  @@index([projectId, factionId, tagId])
  @@index([projectId, artifactId, tagId])
  @@index([projectId, sceneId, tagId])
  @@index([projectId, eventId, tagId])
  @@index([projectId, plotPointId, tagId])
  @@index([projectId, bookId])
  @@index([bookId, chapterId])
}

model Media {
  id               String            @id @default(cuid())
  projectId        String
  uploadedByUserId String
  storageProvider  String            @default("local")
  storageKey       String            @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments      MediaAttachment[]

  @@unique([projectId, id])
  @@index([projectId, createdAt(sort: Desc), id])
}

enum MediaResourceKind {
  PROJECT
  NOTE
  CHARACTER
  PLACE
  FACTION
  ARTIFACT
}

model MediaAttachment {
  id           String            @id @default(cuid())
  projectId    String
  mediaId      String
  resourceKind MediaResourceKind
  noteId       String?
  characterId  String?
  placeId      String?
  factionId    String?
  artifactId   String?
  role         String            @default("attachment")
  createdAt    DateTime          @default(now())
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media        Media             @relation(fields: [projectId, mediaId], references: [projectId, id], onDelete: Cascade)
  note         Note?             @relation(fields: [projectId, noteId], references: [projectId, id], onDelete: Cascade)
  character    Character?        @relation(fields: [projectId, characterId], references: [projectId, id], onDelete: Cascade)
  place        Place?            @relation(fields: [projectId, placeId], references: [projectId, id], onDelete: Cascade)
  faction      Faction?          @relation(fields: [projectId, factionId], references: [projectId, id], onDelete: Cascade)
  artifact     Artifact?         @relation(fields: [projectId, artifactId], references: [projectId, id], onDelete: Cascade)

  @@index([mediaId, id])
  @@index([projectId, resourceKind, id])
  @@index([projectId, noteId])
  @@index([projectId, characterId])
  @@index([projectId, placeId])
  @@index([projectId, factionId])
  @@index([projectId, artifactId])
}

// Durable cleanup intents survive Media/Project/User deletion and process failure.
model MediaCleanup {
  id              String   @id
  projectId       String
  ownerUserId     String
  storageProvider String
  storageKey      String   @unique
  createdAt       DateTime @default(now())

  @@index([ownerUserId, projectId, id])
}

enum AiTask {
  BRAINSTORM
  SUMMARIZE
  REWRITE
}

enum AiStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model AiGeneration {
  id                String    @id @default(uuid())
  projectId         String
  requestedByUserId String
  task              AiTask
  status            AiStatus  @default(QUEUED)
  instructions      String
  inputText         String
  context           Json
  provider          String
  model             String
  promptVersion     String
  result            Json?
  inputTokens       Int?
  outputTokens      Int?
  errorCode         String?
  attempts          Int       @default(0)
  leaseToken        String?
  leaseUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  startedAt         DateTime?
  completedAt       DateTime?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy       User      @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc), id])
  @@index([requestedByUserId, createdAt])
  @@index([status, leaseUntil, createdAt])
}
