{
  "name": "@rawan/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware src/",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@rawan/database": "workspace:*",
    "@rawan/types": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
