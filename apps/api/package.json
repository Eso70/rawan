{
  "name": "@rawan/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "openapi": "pnpm --filter @rawan/api... build && node dist/contracts/openapi.cli.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm --filter @rawan/api... build && vitest run --config ./vitest.config.e2e.ts",
    "test:database": "pnpm --filter @rawan/api... build && node test/database-smoke.mjs",
    "test:domain:database": "pnpm --filter @rawan/api... build && node test/manuscript-database-smoke.mjs",
    "test:world:database": "pnpm --filter @rawan/api... build && node test/worldbuilding-database-smoke.mjs",
    "test:relationships:database": "pnpm --filter @rawan/api... build && node test/relationships-database-smoke.mjs",
    "test:timeline:database": "pnpm --filter @rawan/api... build && node test/timeline-database-smoke.mjs",
    "test:plot:database": "pnpm --filter @rawan/api... build && node test/plot-database-smoke.mjs",
    "test:organization:database": "pnpm --filter @rawan/api... build && node test/organization-database-smoke.mjs",
    "test:search:database": "pnpm --filter @rawan/api... build && node test/search-database-smoke.mjs",
    "test:media:database": "pnpm --filter @rawan/api... build && node test/media-database-smoke.mjs",
    "media:cleanup": "pnpm --filter @rawan/api... build && node dist/media/media-cleanup.cli.js",
    "jobs:cleanup": "pnpm --filter @rawan/api... build && node dist/jobs/jobs.cli.js",
    "test:jobs:integration": "pnpm --filter @rawan/api... build && pnpm --filter @rawan/worker build && node test/jobs-integration.mjs",
    "test:ai:integration": "pnpm --filter @rawan/api... build && pnpm --filter @rawan/worker build && node test/ai-integration.mjs",
    "test:database:all": "pnpm --filter @rawan/api... build && node test/database-regression.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@rawan/backend": "workspace:*",
    "@rawan/database": "workspace:*",
    "@rawan/types": "workspace:*",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "file-type": "22.1.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "multer": "2.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
