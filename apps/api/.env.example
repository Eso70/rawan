# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=3002
# Development defaults to true; test and production default to false. Explicit opt-in is required in production.
OPENAPI_ENABLED=true

# Bounded per-process HTTP abuse defenses; production requires true.
# Tests default false and explicitly enable it in dedicated security checks.
HTTP_RATE_LIMIT_ENABLED=true
# Empty means direct socket identity; configure only the actual ingress proxy IP/CIDR.
HTTP_TRUSTED_PROXIES=
DATABASE_URL="postgresql://rawan:YOUR_PASSWORD@localhost:5432/rawan"
# Generate a secret locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
GOOGLE_CLIENT_ID=
# Exact comma-separated origins, with no trailing slash. Production requires explicit HTTPS origins.
CORS_ORIGINS=
# Test-only: every database/integration suite requires this explicit loopback URL.
# Use a dedicated local test database with CREATE SCHEMA permission.
# Tests use disposable schemas and never fall back to DATABASE_URL.
TEST_DATABASE_URL=

# Private local media storage. Relative paths resolve from apps/api.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_PATH=.data/media
# Bytes; default 10 MiB, maximum 100 MiB. Production requires an absolute durable path.
MEDIA_MAX_FILE_SIZE=10485760

# Locally installed Redis 6.2+. Empty disables API queues in development.
# Required for production API and for the worker.
REDIS_URL=redis://127.0.0.1:6379/0
# Default is rawan-<NODE_ENV>; use the same prefix in API and worker.
QUEUE_PREFIX=rawan-development
MEDIA_CLEANUP_INTERVAL_MS=60000
MEDIA_CLEANUP_SCHEDULE_ENABLED=true
# Queue integration tests require both TEST_DATABASE_URL and explicit TEST_REDIS_URL.
# Tests use a generated namespace and never flush Redis.
TEST_REDIS_URL=

# AI is disabled by default. fake is a deterministic development/test simulator, not a real model.
# Production rejects fake. A real provider adapter must be added before production AI use.
AI_PROVIDER=disabled
AI_MODEL=fake-v1
AI_REQUEST_TIMEOUT_MS=15000
AI_WORKER_CONCURRENCY=1
# AI_API_KEY is intentionally unsupported by the initial fake-only adapter.
