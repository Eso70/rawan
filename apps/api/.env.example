# Rawan — configuration template
# Copy to .env.local and supply your own credentials. Never put real secrets in this template.
# Production uses host-provided environment variables.

# -----------------------------------------------------------------------------
# Application
# Local runtime settings. Production uses environment variables supplied by the host.
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3002
OPENAPI_ENABLED=true

# -----------------------------------------------------------------------------
# PostgreSQL
# DATABASE_URL is the connection used by the application. Keep it consistent across services.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://rawan:YOUR_PASSWORD@localhost:5432/rawan"

# -----------------------------------------------------------------------------
# Session security
# JWT_SECRET signs sessions. Use a long random secret; never expose it in client code.
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# Google sign-in
# Public client identifier. The Google client secret belongs only in the website server configuration.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Email verification (Gmail)
# Enable after configuring the sender account and its 16-character app password. EMAIL_CODE_SECRET must be a separate random secret.
# -----------------------------------------------------------------------------
EMAIL_SIGNUP_ENABLED=false
EMAIL_FROM=rawanproject3@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_CODE_SECRET=
EMAIL_APP_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# HTTP security and allowed origins
# Use exact origins without trailing slashes. Trust only the actual ingress proxy addresses.
# -----------------------------------------------------------------------------
CORS_ORIGINS=
HTTP_RATE_LIMIT_ENABLED=true
HTTP_TRUSTED_PROXIES=

# -----------------------------------------------------------------------------
# Media storage
# Local paths are service-relative in development. Production needs an absolute durable path.
# -----------------------------------------------------------------------------
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_PATH=.data/media
MEDIA_MAX_FILE_SIZE=10485760

# -----------------------------------------------------------------------------
# Redis and background jobs
# Use the same Redis URL and queue prefix in the API and worker. Redis 6.2+ is required.
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_PREFIX=rawan-development

# -----------------------------------------------------------------------------
# Scheduled maintenance
# Controls automatic cleanup scheduling; interval is in milliseconds.
# -----------------------------------------------------------------------------
MEDIA_CLEANUP_SCHEDULE_ENABLED=true
MEDIA_CLEANUP_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# AI assistance
# Disabled by default. External processing requires explicit opt-in and a server-side provider key.
# -----------------------------------------------------------------------------
AI_PROVIDER=disabled
AI_MODEL=fake-v1
AI_API_KEY=
AI_EXTERNAL_PROCESSING_ENABLED=false
AI_REQUEST_TIMEOUT_MS=15000
AI_WORKER_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Test services (optional)
# Explicit loopback test targets only. Tests use disposable schemas/namespaces and never fall back to production connections.
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=
TEST_REDIS_URL=
