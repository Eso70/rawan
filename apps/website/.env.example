# Rawan — configuration template
# Copy to .env.local and supply your own credentials. Never put real secrets in this template.
# Production uses host-provided environment variables.

# -----------------------------------------------------------------------------
# Website and API addresses
# Local authentication origin and backend base URL. Keep credentials server-side.
# -----------------------------------------------------------------------------
AUTH_ORIGIN=http://localhost:3000
RAWAN_API_URL=http://127.0.0.1:3002/api/v1

# -----------------------------------------------------------------------------
# Google sign-in
# Client ID and server-only secret from the Google OAuth configuration. Do not prefix secrets with NEXT_PUBLIC_.
# In the Google web client, authorize JavaScript origin http://localhost:3000
# and redirect URI http://localhost:3000/auth/google/callback.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
