{
  "name": "@rawan/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Rawan BullMQ background worker",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware src/",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "pnpm --filter @rawan/api test:jobs:integration"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.4",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@rawan/backend": "workspace:*",
    "@rawan/database": "workspace:*",
    "@rawan/types": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.23.1",
    "dotenv": "^18.0.5"
  }
}
