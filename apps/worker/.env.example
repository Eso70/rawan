# Development loads this file first, then apps/api/.env without overriding values.
# Production uses process environment only; configure DATABASE_URL and an absolute MEDIA_LOCAL_PATH.
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_PREFIX=rawan-development
WORKER_CONCURRENCY=2
# Optional overrides; otherwise the API development configuration is reused.
# DATABASE_URL=postgresql://rawan:YOUR_PASSWORD@localhost:5432/rawan
# MEDIA_STORAGE_DRIVER=local
# MEDIA_LOCAL_PATH=.data/media
AI_PROVIDER=disabled
AI_MODEL=fake-v1
AI_REQUEST_TIMEOUT_MS=15000
AI_WORKER_CONCURRENCY=1
