# Rawan — configuration template
# Copy to .env.local and supply your own credentials. Never put real secrets in this template.
# Production uses host-provided environment variables.

# -----------------------------------------------------------------------------
# Application
# Local runtime settings. Production uses environment variables supplied by the host.
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Redis and background jobs
# Use the same Redis URL and queue prefix in the API and worker. Redis 6.2+ is required.
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_PREFIX=rawan-development
WORKER_CONCURRENCY=2

# -----------------------------------------------------------------------------
# AI assistance
# Disabled by default. External processing requires explicit opt-in and a server-side provider key.
# -----------------------------------------------------------------------------
AI_PROVIDER=disabled
AI_MODEL=fake-v1
AI_API_KEY=
AI_EXTERNAL_PROCESSING_ENABLED=false
AI_REQUEST_TIMEOUT_MS=15000
AI_WORKER_CONCURRENCY=1
