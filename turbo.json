{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "env": ["API_URL"],
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "src/generated/prisma/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "NODE_ENV",
        "PORT",
        "CORS_ORIGINS",
        "API_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@rawan/api#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@rawan/api#test": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
