{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@rawan/website#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/prisma/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "JWT_SECRET",
        "NODE_ENV",
        "PORT",
        "CORS_ORIGINS",
        "HTTP_RATE_LIMIT_ENABLED",
        "HTTP_TRUSTED_PROXIES",
        "REDIS_URL",
        "QUEUE_PREFIX",
        "MEDIA_STORAGE_DRIVER",
        "MEDIA_LOCAL_PATH",
        "MEDIA_MAX_FILE_SIZE",
        "MEDIA_CLEANUP_INTERVAL_MS",
        "MEDIA_CLEANUP_SCHEDULE_ENABLED",
        "WORKER_CONCURRENCY",
        "AI_PROVIDER",
        "AI_MODEL",
        "AI_REQUEST_TIMEOUT_MS",
        "AI_WORKER_CONCURRENCY",
        "AI_API_KEY",
        "OPENAPI_ENABLED"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.oxlintrc.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@rawan/api#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@rawan/api#test": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
